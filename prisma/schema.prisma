generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  label     String?
  updatedAt DateTime @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  titleAr         String
  titleEn         String?
  descriptionAr   String   @db.Text
  descriptionEn   String?  @db.Text
  image           String?
  icon            String?
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  country   String   @default("KSA")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id            String   @id @default(cuid())
  country       String
  countryAr     String
  city          String
  cityAr        String
  address       String   @db.Text
  addressAr     String   @db.Text
  phone         String?
  email         String?
  image         String?
  description   String?  @db.Text
  descriptionAr String?  @db.Text
  latitude      Float?
  longitude     Float?
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NewsArticle {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String?
  contentAr   String?  @db.Text
  contentEn   String?  @db.Text
  summaryAr   String?  @db.Text
  summaryEn   String?  @db.Text
  image       String?
  publishDate DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id            String   @id @default(cuid())
  titleAr       String
  titleEn       String?
  descriptionAr String?  @db.Text
  descriptionEn String?  @db.Text
  image         String?
  eventDate     DateTime?
  locationAr    String?
  locationEn    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MediaImage {
  id        String   @id @default(cuid())
  title     String?
  image     String
  category  String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobListing {
  id             String   @id @default(cuid())
  titleAr        String
  titleEn        String?
  departmentAr   String?
  departmentEn   String?
  locationAr     String?
  locationEn     String?
  type           String?
  descriptionAr  String?  @db.Text
  descriptionEn  String?  @db.Text
  requirementsAr String?  @db.Text
  requirementsEn String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SupplierRequest {
  id        String   @id @default(cuid())
  name      String
  company   String
  phone     String
  email     String
  message   String?  @db.Text
  fileUrl   String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}